{
  "name": "@products/fogline-mobile",
  "version": "0.1.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "expo start --port 8251",
    "dev:ios": "expo start --port 8251 --ios",
    "dev:android": "expo start --port 8251 --android",
