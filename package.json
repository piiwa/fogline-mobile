    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "deadcode": "knip",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm deadcode && pnpm test"
  },
