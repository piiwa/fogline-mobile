# Fogline mobile — pnpm config tuned for React Native / Metro.
#
# Why hoisted ? Metro (the RN bundler) resolves modules from the top-level
# node_modules. pnpm's default isolated layout symlinks transitive deps inside
# `.pnpm/<name>@<v>/node_modules/`, which Metro can't follow. The canonical
# failure mode is "Cannot resolve module react-native-css-interop" (a NativeWind
# transitive that Metro can't find because it's not hoisted).
#
# `node-linker=hoisted` makes pnpm install like npm/yarn — every package lands at
# top-level. Pays a little disk in exchange for "things just work" with
# Metro / Expo / RN native plugins.
node-linker=hoisted
